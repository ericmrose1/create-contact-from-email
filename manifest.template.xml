<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>8768cc0a-cace-46c8-91cb-9cbe36af6d73</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>Personal Outlook Tool</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Create Contact from Email" />
  <Description DefaultValue="Extract sender contact details from an email and prepare an Outlook contact for review." />
  <IconUrl DefaultValue="__HOST__/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="__HOST__/assets/icon-128.png" />
  <SupportUrl DefaultValue="__HOST__/index.html" />
  <Hosts><Host Name="Mailbox" /></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.6" /></Sets></Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead"><DesktopSettings><SourceLocation DefaultValue="__HOST__/index.html" /><RequestedHeight>450</RequestedHeight></DesktopSettings></Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or"><Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" /></Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.6"><bt:Set Name="Mailbox" /></bt:Sets></Requirements>
    <Hosts><Host xsi:type="MailHost"><DesktopFormFactor>
      <ExtensionPoint xsi:type="MessageReadCommandSurface"><OfficeTab id="TabDefault"><Group id="ContactTools.Group"><Label resid="Group.Label" />
        <Control xsi:type="Button" id="CreateContact.Button"><Label resid="Button.Label" /><Supertip><Title resid="Button.Label" /><Description resid="Button.Tooltip" /></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16" /><bt:Image size="32" resid="Icon.32" /><bt:Image size="80" resid="Icon.80" /></Icon>
          <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url" /></Action>
        </Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="__HOST__/assets/icon-16.png" /><bt:Image id="Icon.32" DefaultValue="__HOST__/assets/icon-32.png" /><bt:Image id="Icon.80" DefaultValue="__HOST__/assets/icon-80.png" /></bt:Images>
      <bt:Urls><bt:Url id="Taskpane.Url" DefaultValue="__HOST__/index.html" /></bt:Urls>
      <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="Contacts" /><bt:String id="Button.Label" DefaultValue="Create Contact from Email" /></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Button.Tooltip" DefaultValue="Extract the sender's signature details and prepare an Outlook contact for review." /></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
